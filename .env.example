# Copy this file to .env and adjust. .env is git-ignored - never commit real credentials.

# PostgreSQL 16 with pgvector (docker compose maps it to port 5434 to avoid clashing with a local install).
# Neon / Supabase also work: paste their connection string here.
DATABASE_URL=postgres://rahat:rahat_dev_pw@localhost:5434/rahat

# MongoDB (optional - field reports and the activity log; the rest of the app works without it)
MONGODB_URI=mongodb://localhost:27018
MONGODB_DB=rahat

# Secret used to sign login sessions (JWT). Use 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# Local embedding model (downloads ~120 MB once). Set EMBEDDINGS_DISABLED=1 to turn semantic matching off.
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_DISABLED=0

# Credentials for the docker compose database (only used by docker-compose.yml)
POSTGRES_USER=rahat
POSTGRES_PASSWORD=rahat_dev_pw
POSTGRES_DB=rahat
